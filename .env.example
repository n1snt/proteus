# These values are for local development only. Do not use these secrets on a server.
PROTEUS_MODE=local
PROTEUS_SECRET_KEY=development-only-change-before-sharing
PROTEUS_COOKIE_SECURE=false
PROTEUS_POSTGRES_PASSWORD=proteus_local
PROTEUS_DATABASE_URL=postgresql://postgres:proteus_local@127.0.0.1:55432/proteus
PROTEUS_SANDBOX_URL=postgresql://postgres:proteus_local@127.0.0.1:55433/proteus_sandbox
PROTEUS_STATIC_DIR=web/dist
PROTEUS_DEMO_TTL_HOURS=24
PROTEUS_MAX_PROJECTS=20
PROTEUS_MAX_BRANCHES=20
